rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── KULLANICI VERİSİ ──────────────────────────────────────────────────
    // Her kullanıcı yalnızca KENDİ verisini okuyup yazabilir.
    match /users/{uid}/data/{document} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Kullanıcı profili (rol, joinedClassCode, displayName vb.)
    match /users/{uid}/profile/{document} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── SINIF YÖNETİMİ ────────────────────────────────────────────────────
    // Sınıf belgesi: herkes okuyabilir (kod doğrulama için),
    //               yalnızca öğretmen (teacherUid) oluşturabilir/silebilir.
    match /classes/{code} {
      // Giriş yapmış herkes kodu doğrulamak için okuyabilir
      allow read: if request.auth != null;

      // Yalnızca sınıfı oluşturan öğretmen (teacherUid = auth.uid) yazabilir
      allow create: if request.auth != null
                    && request.resource.data.teacherUid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100;

      allow update, delete: if request.auth != null
                            && resource.data.teacherUid == request.auth.uid;
    }

    // Sınıf üyeleri:
    //   - Giriş yapmış herkes okuyabilir (öğretmen sıralama tablosunu görsün)
    //   - Her kullanıcı yalnızca KENDİ üye belgesini yazabilir
    match /classes/{code}/members/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Sınıfa özel kelimeler:
    //   - Giriş yapmış herkes okuyabilir
    //   - Yalnızca kelimenin sahibi öğretmen (teacherUid) ekleyip silebilir
    match /classes/{code}/words/{wordId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.teacherUid == request.auth.uid;
    }

    // ── VARSAYILAN: HER ŞEYİ REDDET ──────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
